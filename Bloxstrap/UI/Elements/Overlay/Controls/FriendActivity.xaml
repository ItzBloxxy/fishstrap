<UserControl x:Class="Bloxstrap.UI.Elements.Overlay.Controls.FriendActivity"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:resources="clr-namespace:Bloxstrap.Resources"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="560" d:DesignWidth="820"
             FontFamily="{StaticResource Inter}"
             Loaded="OnLoaded">

    <UserControl.Resources>
        <Style x:Key="ConversationItem" TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="4" Background="Transparent" Padding="8" Margin="0,0,0,2">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{ui:ThemeResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{ui:ThemeResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" MinWidth="200" MaxWidth="360" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="8,8,6,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ui:TextBox Grid.Row="0" Margin="0,0,0,6" FontSize="13"
                        PlaceholderText="{x:Static resources:Strings.Menu_Overlay_Messages_Search}"
                        Text="{Binding SearchTextBoxContent, UpdateSourceTrigger=PropertyChanged}" />

            <Grid Grid.Row="1">
                <TextBlock Text="{x:Static resources:Strings.Menu_Overlay_Messages_Empty}" FontSize="12"
                           VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"
                           Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                           Visibility="{Binding ShowEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <ListBox ItemsSource="{Binding FriendsList}" Background="Transparent" BorderThickness="0"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         ItemContainerStyle="{StaticResource ConversationItem}"
                         SelectionChanged="ConversationsSelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="40">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Width="36" Height="36" CornerRadius="18" Margin="0,0,10,0"
                                        Background="{ui:ThemeResource ControlFillColorDefaultBrush}">
                                    <Border CornerRadius="18">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding ProfileImage}" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Username}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding StatusText}" FontSize="11" Margin="0,1,0,0"
                                               Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>

        <Rectangle Grid.Column="1" Width="1" Fill="{ui:ThemeResource DividerStrokeColorDefaultBrush}" />

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{x:Static resources:Strings.Menu_Overlay_Messages_PickConversation}"
                       FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"
                       Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                       Visibility="{Binding ShowConversationPlaceholder, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="10,10,4,0"
                          VirtualizingPanel.ScrollUnit="Pixel">
                <ItemsControl ItemsSource="{Binding MessagesList}" Margin="0,0,6,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6" HorizontalAlignment="{Binding Alignment}">
                                <Border CornerRadius="8" Padding="12,8" MaxWidth="420"
                                        Background="{Binding Background}" Opacity="{Binding Opacity}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Sender}" FontSize="11" Margin="0,0,0,3"
                                                   Visibility="{Binding SenderVisibility}"
                                                   Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock x:Name="Body" Text="{Binding Text}" FontSize="13" TextWrapping="Wrap"
                                                   Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsCurrentUser}" Value="True">
                                    <Setter TargetName="Body" Property="Foreground"
                                            Value="{ui:ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Grid Grid.Row="1" Margin="10,8,10,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:TextBox x:Name="MessageTextBox" Grid.Column="0" FontSize="13" Margin="0,0,6,0"
                            PlaceholderText="{x:Static resources:Strings.Menu_Overlay_Messages_Write}"
                            Text="{Binding MessageTextBoxContent, UpdateSourceTrigger=PropertyChanged}"
                            KeyDown="MessageTextBoxKeyDown" />

                <ui:Button Grid.Column="1" MinWidth="76" Appearance="Primary"
                           Content="{x:Static resources:Strings.Menu_Overlay_Messages_Send}"
                           Command="{Binding SendMessageCommand}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
