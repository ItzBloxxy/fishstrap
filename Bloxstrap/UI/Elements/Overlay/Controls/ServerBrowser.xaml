<UserControl x:Class="Bloxstrap.UI.Elements.Overlay.Controls.ServerBrowser"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:resources="clr-namespace:Bloxstrap.Resources"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="560" d:DesignWidth="820"
             FontFamily="{StaticResource Inter}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="0,0,0,8" Padding="12,10" CornerRadius="6"
                Background="{ui:ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                Visibility="{Binding HasCurrentServer, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static resources:Strings.ContextMenu_ServerInformation_Type}"
                           FontSize="12" Margin="0,0,12,0" VerticalAlignment="Center"
                           Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CurrentServerType}" FontSize="13"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static resources:Strings.ContextMenu_ServerInformation_InstanceId}"
                           FontSize="12" Margin="0,6,12,0" VerticalAlignment="Center"
                           Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}" />
                <Grid Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding CurrentJobId}" FontSize="11" VerticalAlignment="Center"
                               FontFamily="{StaticResource CascadiaCode}" TextTrimming="CharacterEllipsis"
                               Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />

                    <ui:Button Grid.Column="1" Width="24" Height="24" Padding="0" Margin="6,0,0,0"
                               VerticalAlignment="Center" Appearance="Transparent"
                               ToolTip="{x:Static resources:Strings.ContextMenu_ServerInformation_CopyInstanceId}"
                               Command="{Binding CopyInstanceIdCommand}">
                        <ui:SymbolIcon Symbol="Copy24" FontSize="12" />
                    </ui:Button>
                </Grid>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="{x:Static resources:Strings.ContextMenu_ServerInformation_Location}"
                           FontSize="12" Margin="20,0,12,0" VerticalAlignment="Center"
                           Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                           Visibility="{Binding ShowCurrentLocation, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding CurrentLocation}" FontSize="13"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                           Visibility="{Binding ShowCurrentLocation, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <TextBlock Grid.Row="1" Grid.Column="2" Text="{x:Static resources:Strings.ContextMenu_ServerInformation_Uptime}"
                           FontSize="12" Margin="20,6,12,0" VerticalAlignment="Center"
                           Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding CurrentUptime}" FontSize="13" Margin="0,6,0,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" />

                <ui:Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="4" Margin="16,0,0,0" VerticalAlignment="Center"
                           Appearance="Primary" Command="{Binding HopCommand}" IsEnabled="{Binding CanHop}"
                           ToolTip="{x:Static resources:Strings.Menu_Overlay_Servers_HopTooltip}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowShuffle24" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="{x:Static resources:Strings.Menu_Overlay_Servers_Hop}" FontSize="13" />
                    </StackPanel>
                </ui:Button>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="0,0,0,8" Padding="10,6" CornerRadius="6"
                Background="{ui:ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,3,20,3" VerticalAlignment="Center">
                        <TextBlock Text="{x:Static resources:Strings.Menu_Overlay_Servers_SortByPlayers}" FontSize="13"
                                   VerticalAlignment="Center" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />

                        <ComboBox Margin="10,0,0,0" MinWidth="140" ItemsSource="{Binding Orders, Mode=OneTime}"
                                  SelectedItem="{Binding SelectedOrder, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,3,20,3" VerticalAlignment="Center">
                        <TextBlock Text="{x:Static resources:Strings.Menu_Overlay_Servers_Region}" FontSize="13"
                                   VerticalAlignment="Center" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />

                        <ComboBox Margin="10,0,0,0" MinWidth="150" MaxDropDownHeight="280"
                                  ItemsSource="{Binding Regions}" SelectedItem="{Binding SelectedRegion, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,3,0,3" VerticalAlignment="Center">
                        <ui:ToggleSwitch VerticalAlignment="Center" IsChecked="{Binding ExcludeFull, Mode=TwoWay}" />
                        <TextBlock Text="{x:Static resources:Strings.Menu_Overlay_Servers_HideFull}" FontSize="13" Margin="10,0,0,0"
                                   VerticalAlignment="Center" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </WrapPanel>

                <TextBlock Grid.Column="1" Text="{Binding SummaryText}" FontSize="13" Margin="16,0,12,0"
                           VerticalAlignment="Center" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />

                <ui:Button Grid.Column="2" Appearance="Secondary" VerticalAlignment="Center"
                           Command="{Binding RefreshCommand}" IsEnabled="{Binding CanRefresh}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowSync24" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="{x:Static resources:Strings.Menu_Overlay_Refresh}" FontSize="13" />
                    </StackPanel>
                </ui:Button>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <ui:ProgressRing IsIndeterminate="True" Width="32" Height="32"
                             VerticalAlignment="Center" HorizontalAlignment="Center"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <TextBlock Text="{Binding EmptyText}" FontSize="13" TextAlignment="Center" TextWrapping="Wrap"
                       VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="320"
                       Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                       Visibility="{Binding ShowEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <ItemsControl ItemsSource="{Binding Servers}"
                          ScrollViewer.CanContentScroll="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-8,0" Padding="0,0,8,0">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Row" Margin="0,0,0,6" Padding="10" CornerRadius="8"
                                Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <ItemsControl ItemsSource="{Binding PlayerIcons}" VerticalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="26" Height="26" CornerRadius="13" Margin="0,0,-7,0"
                                                            BorderThickness="1.5"
                                                            BorderBrush="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                            Background="{ui:ThemeResource ControlFillColorDefaultBrush}">
                                                        <Border CornerRadius="12">
                                                            <Border.Background>
                                                                <ImageBrush ImageSource="{Binding}" Stretch="UniformToFill" />
                                                            </Border.Background>
                                                        </Border>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Border Height="22" MinWidth="22" CornerRadius="11" Padding="6,0" Margin="11,0,0,0"
                                                VerticalAlignment="Center"
                                                Background="{ui:ThemeResource ControlFillColorSecondaryBrush}"
                                                Visibility="{Binding HasOverflow, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="{Binding OverflowText}" FontSize="11" VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                                        </Border>

                                        <TextBlock x:Name="NoFaces" Text="{Binding PlayersText}" FontSize="14" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Visibility="Collapsed"
                                                   Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" />
                                    </StackPanel>
                                    <ProgressBar Height="3" Margin="0,6,0,0" Maximum="100"
                                                 Value="{Binding FillPercentage, Mode=OneWay}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding LocationText}" FontSize="13"
                                               Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding ShortId}" FontSize="11" Margin="0,1,0,0"
                                               FontFamily="{StaticResource CascadiaCode}"
                                               Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding UptimeText}" FontSize="12" MinWidth="80" TextAlignment="Right"
                                               Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                               Visibility="{Binding HasUptime, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBlock Text="{Binding FpsText}" FontSize="12" MinWidth="64" TextAlignment="Right"
                                               Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding PingText}" FontSize="12" MinWidth="64" TextAlignment="Right"
                                               Margin="12,0,0,0"
                                               Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <ui:Button Grid.Column="3" Width="34" Height="34" Padding="0" Margin="0,0,8,0"
                                           VerticalAlignment="Center" Appearance="Secondary"
                                           ToolTip="{x:Static resources:Strings.Menu_Overlay_Servers_CopyLink}"
                                           Command="{Binding DataContext.CopyLinkCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                           CommandParameter="{Binding Mode=OneTime}">
                                    <ui:SymbolIcon Symbol="Link24" FontSize="14" />
                                </ui:Button>

                                <ui:Button x:Name="JoinButton" Grid.Column="4" MinWidth="76" Appearance="Primary"
                                           Content="{x:Static resources:Strings.Menu_Overlay_Servers_Join}"
                                           Command="{Binding DataContext.JoinCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                           CommandParameter="{Binding Mode=OneTime}" />

                                <TextBlock x:Name="CurrentLabel" Grid.Column="4" FontSize="12" VerticalAlignment="Center"
                                           HorizontalAlignment="Center" Visibility="Collapsed"
                                           Text="{x:Static resources:Strings.Menu_Overlay_Servers_Current}"
                                           Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}" />
                            </Grid>
                        </Border>

                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding PlayerIcons.Count}" Value="0">
                                <Setter TargetName="NoFaces" Property="Visibility" Value="Visible" />
                            </DataTrigger>

                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="Row" Property="BorderBrush"
                                        Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="JoinButton" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="CurrentLabel" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Grid>
</UserControl>
