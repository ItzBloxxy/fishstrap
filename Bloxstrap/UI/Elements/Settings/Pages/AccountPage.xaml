<ui:UiPage x:Class="Bloxstrap.UI.Elements.Settings.Pages.AccountPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:Bloxstrap.UI.Elements.Settings.Pages"
      xmlns:models="clr-namespace:Bloxstrap.UI.ViewModels.Settings"
      xmlns:resources="clr-namespace:Bloxstrap.Resources"
      xmlns:enums="clr-namespace:Bloxstrap.Enums"
      xmlns:utility="clr-namespace:Bloxstrap.UI.Utility"
      xmlns:entities="clr-namespace:Bloxstrap.Models.Entities"
      d:DataContext="{d:DesignInstance Type=models:AccountViewModel}"
      mc:Ignorable="d"
      d:DesignHeight="900" d:DesignWidth="800"
      Title="AccountPage"
      Scrollable="True">

    <StackPanel Margin="0,0,14,14">
        <TextBlock Margin="0,0,0,8" Text="{x:Static resources:Strings.Menu_Account_Description}" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <ui:InfoBar
            Title="{x:Static resources:Strings.Menu_Playtime_CookieAccessRequired_Title}"
            Message="{x:Static resources:Strings.Menu_Playtime_CookieAccessRequired_Description}"
            Severity="Warning"
            IsClosable="False"
            IsOpen="{Binding CookieAccessDisabled, Mode=OneWay}" />

        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CookieAccessDisabled, Mode=OneWay}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <StackPanel Margin="0,48,0,0" HorizontalAlignment="Center" VerticalAlignment="Top">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBusy, Mode=OneWay}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <ui:ProgressRing IsIndeterminate="True" Width="48" Height="48" HorizontalAlignment="Center" />
                <TextBlock Text="{x:Static resources:Strings.Menu_Playtime_Loading}"
                           Margin="0,16,0,0"
                           HorizontalAlignment="Center"
                           FontSize="13"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <ui:InfoBar
                Title="{x:Static resources:Strings.Menu_Playtime_LoadFailed}"
                Message="{Binding Error, Mode=OneWay}"
                Severity="Error"
                IsClosable="False">
                <ui:InfoBar.Style>
                    <Style TargetType="ui:InfoBar">
                        <Setter Property="IsOpen" Value="False" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LoadState, Mode=OneWay}" Value="{x:Static enums:GenericTriState.Failed}">
                                <Setter Property="IsOpen" Value="True" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ui:InfoBar.Style>
            </ui:InfoBar>

            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding LoadState, Mode=OneWay}" Value="{x:Static enums:GenericTriState.Successful}" />
                                    <Condition Binding="{Binding IsBusy, Mode=OneWay}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <ItemsControl Margin="0,8,0,8" ItemsSource="{Binding Accounts, Mode=OneWay}">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasAccounts, Mode=OneWay}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type entities:RobloxAccount}">
                            <Border Margin="0,0,0,8" Padding="12" CornerRadius="8"
                                    Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" ClipToBounds="True"
                                            Background="{ui:ThemeResource ControlFillColorDefaultBrush}">
                                        <Image Source="{Binding AvatarUrl, Mode=OneTime}" Stretch="UniformToFill" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Label, Mode=OneTime}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding UsernameText, Mode=OneTime}" FontSize="12" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>

                                    <ui:Button Grid.Column="2" VerticalAlignment="Center"
                                               Appearance="Secondary"
                                               Content="{x:Static resources:Strings.Menu_Account_Switch}"
                                               Command="{Binding DataContext.SwitchCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               CommandParameter="{Binding Mode=OneTime}">
                                        <ui:Button.Style>
                                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive, Mode=OneTime}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:Button.Style>
                                    </ui:Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="{x:Static resources:Strings.Menu_Playtime_ScreenTime}" FontSize="20" FontWeight="Medium" VerticalAlignment="Center" />
                        <ui:Button
                            HorizontalAlignment="Right"
                            Appearance="Secondary"
                            Icon="ArrowClockwise24"
                            Content="{x:Static resources:Strings.Menu_Playtime_Refresh}"
                            Command="{Binding RefreshCommand, Mode=OneTime}">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                    <Setter Property="IsEnabled" Value="True" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBusy, Mode=OneWay}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                    </Grid>

                    <Grid Grid.Row="0" Grid.Column="1" Margin="16,0,0,0">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasBreakdown, Mode=OneWay}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <TextBlock Text="{x:Static resources:Strings.Menu_Playtime_Breakdown}" FontSize="20" FontWeight="Medium" VerticalAlignment="Center" />
                    </Grid>

                    <Border Grid.Row="1" Grid.Column="0" Margin="0,8,0,0" Padding="16" CornerRadius="8"
                            Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <TextBlock Text="{Binding AverageText, Mode=OneWay}" FontSize="28" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Static resources:Strings.Menu_Playtime_SevenDayAverage}" FontSize="13" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <Grid Grid.Row="1" VerticalAlignment="Bottom" Margin="0,20,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ItemsControl Grid.Column="0" ItemsSource="{Binding Days, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="6,0">
                                                <Grid Height="{Binding DataContext.ChartHeight, RelativeSource={RelativeSource AncestorType=ItemsControl}, Mode=OneTime}">
                                                    <Border VerticalAlignment="Bottom"
                                                            CornerRadius="4"
                                                            Height="{Binding BarHeight, Mode=OneTime}"
                                                            ToolTip="{Binding DurationText, Mode=OneTime}">
                                                        <Border.Background>
                                                            <SolidColorBrush Color="{DynamicResource SystemAccentColorSecondary}" />
                                                        </Border.Background>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="{Binding Label, Mode=OneTime}"
                                                           Margin="0,8,0,0"
                                                           FontSize="12"
                                                           TextAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl Grid.Column="1"
                                              Margin="12,0,0,0"
                                              Height="{Binding ChartHeight, Mode=OneTime}"
                                              VerticalAlignment="Top"
                                              ItemsSource="{Binding AxisLabels, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="1" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Mode=OneTime}"
                                                       FontSize="12"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Top"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="1" Margin="16,8,0,0" Padding="16" CornerRadius="8"
                            Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasBreakdown, Mode=OneWay}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <StackPanel>
                            <Grid HorizontalAlignment="Center"
                                  Width="{Binding DonutSize, Mode=OneTime}"
                                  Height="{Binding DonutSize, Mode=OneTime}"
                                  VerticalAlignment="Center">
                                <ItemsControl ItemsSource="{Binding Slices, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Grid />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type utility:DonutSlice}">
                                            <Path Data="{Binding Geometry, Mode=OneTime}"
                                                  Stroke="{Binding Brush, Mode=OneTime}"
                                                  StrokeThickness="{Binding DataContext.DonutThickness, RelativeSource={RelativeSource AncestorType=ItemsControl}, Mode=OneTime}"
                                                  StrokeStartLineCap="Flat"
                                                  StrokeEndLineCap="Flat"
                                                  ToolTip="{Binding ValueText, Mode=OneTime}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="{x:Static resources:Strings.Menu_Playtime_ThisWeek}"
                                               FontSize="11"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding BreakdownTotalText, Mode=OneWay}"
                                               FontSize="24"
                                               FontWeight="SemiBold"
                                               Margin="0,2,0,0"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <ItemsControl Margin="0,16,0,0"
                                          Width="{Binding DonutSize, Mode=OneTime}"
                                          ItemsSource="{Binding Slices, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type utility:DonutSlice}">
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center"
                                                     Fill="{Binding Brush, Mode=OneTime}" />
                                            <TextBlock Grid.Column="1" Margin="10,0,10,0"
                                                       Text="{Binding Label, Mode=OneTime}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ValueText, Mode=OneTime}" />
                                                <TextBlock Text="{Binding PercentText, Mode=OneTime}"
                                                           Margin="8,0,0,0"
                                                           MinWidth="36"
                                                           TextAlignment="Right"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{x:Static resources:Strings.Menu_Playtime_NoData}"
                               Margin="0,16,0,0"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEmpty, Mode=OneWay}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <Grid Margin="0,24,0,0">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasGames, Mode=OneWay}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <TextBlock Text="{x:Static resources:Strings.Menu_Playtime_TopGames}" FontSize="20" FontWeight="Medium" VerticalAlignment="Center" />
                    <ui:Button HorizontalAlignment="Right"
                               Appearance="Transparent"
                               Content="{Binding ViewMoreText, Mode=OneTime}"
                               Command="{Binding ViewMoreCommand, Mode=OneTime}">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanExpandGames, Mode=OneWay}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>
                </Grid>

                <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Games, Mode=OneWay}">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasGames, Mode=OneWay}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8" Padding="12" CornerRadius="8"
                                    Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="6" ClipToBounds="True"
                                            Background="{ui:ThemeResource ControlFillColorDefaultBrush}">
                                        <Image Source="{Binding ThumbnailUrl, Mode=OneTime}" Stretch="UniformToFill" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name, Mode=OneTime}" FontWeight="Medium" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Foreground>
                                                <SolidColorBrush Color="{DynamicResource SystemAccentColorSecondary}" />
                                            </TextBlock.Foreground>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Genre, Mode=OneTime}" FontSize="12" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{Binding DurationText, Mode=OneTime}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </StackPanel>
</ui:UiPage>
